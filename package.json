{
  "name": "smart-arrival-backend",
  "version": "1.0.0",
  "description": "Backend for Smart Location-Based Safety & Arrival System (V1)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "node-pg-migrate up -m migrations -j sql"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "twilio": "^5.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "node-pg-migrate": "^7.6.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
